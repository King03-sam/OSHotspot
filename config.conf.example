# OSHotspot Configuration
# Copy this file to /etc/oshotspot/config.conf and edit as needed.

# WiFi Hotspot Name (SSID)
SSID="OSHotspot"

# WiFi Hotspot Password (min 8 characters for WPA2)
PASSWORD="ChangeMe123"

# WiFi channel (1-13, default: 6)
CHANNEL=6

# WiFi hardware mode (g for 2.4GHz, a for 5GHz)
HW_MODE="g"

# Country code (FR, US, GB, etc.) - required by some drivers
COUNTRY_CODE="FR"

# Hostname shown on the network
HOSTNAME="oshotspot"

# AP interface name (created automatically)
AP_IFACE="ap0"

# Your internet-connected WiFi interface (auto-detected if empty)
# If you have multiple WiFi adapters, set the one connected to the internet:
# WIFI_IFACE="wlp2s0"
# Run 'sudo oshotspot interfaces' to see available adapters.
WIFI_IFACE=""

# Hotspot subnet
SUBNET="192.168.50.0"
AP_IP="192.168.50.1"
AP_CIDR="24"
DHCP_RANGE_START="192.168.50.10"
DHCP_RANGE_END="192.168.50.100"
DHCP_LEASE="12h"

# DNS servers
DNS_PRIMARY="8.8.8.8"
DNS_SECONDARY="1.1.1.1"

# DNS traffic policy (default: true)
# When enabled, all DNS traffic from hotspot clients is redirected to the
# local dnsmasq, and DNS-over-HTTPS resolver IPs are blocked on port 443.
# Set to "false" to disable DNS redirect and DoH blocking.
DNS_REDIRECT="true"

# Dashboard Remote Access
# Bind address for the web dashboard.
# Use "0.0.0.0" to allow access from all interfaces (required for VPN access).
# Use "127.0.0.1" to restrict to local access only.
DASHBOARD_BIND_ADDRESS="0.0.0.0"

# Open WiFi (No password required)
WIFI_OPEN="false"

# Captive Portal
CAPTIVE_PORTAL="false"
CAPTIVE_CODE=""
CAPTIVE_MESSAGE="Welcome to OSHotspot! Please accept terms or enter access code to connect."
# Custom domain name for the captive portal (optional)
# When set, hotspot clients can access the portal via this domain (e.g. wifi.portal)
# The domain is resolved locally to the AP via dnsmasq — no external DNS needed.
CAPTIVE_DOMAIN=""

# SPAN Port Switch Log Analysis
SPAN_ENABLED="false"
SPAN_INTERFACE=""

# Dashboard inactivity timeout (seconds)
# Set to 0 to disable auto-shutdown. Default: 7200 (2 hours)
INACTIVITY_TIMEOUT="7200"

# Email alerts (optional, disabled by default)
# When enabled, the event collector emails a notification for each alert
# (unknown device joined, DNS flood). Alerts are always written to
# /var/log/oshotspot/events.log regardless of this setting.
#
# Recommended: use msmtp (lightweight MTA) — run 'sudo oshotspot setup-mail'
# to configure.  msmtp handles SMTP auth and TLS; OSHotspot sends via
# 'sendmail' (localhost:25) to msmtp for delivery.
#
# Alternative: set SMTP mode to 'direct' and fill SMTP host/port/credentials
# below.  The backend will connect directly without msmtp.
#
# ALERT_EMAIL_ENABLED="false"
# ALERT_EMAIL_SMTP_MODE="msmtp"     # msmtp (recommended) or direct
# ALERT_EMAIL_TO="you@example.com"
# ALERT_EMAIL_FROM="oshotspot@localhost"
# ALERT_EMAIL_SMTP_HOST=""          # only for mode=direct (e.g. smtp.gmail.com)
# ALERT_EMAIL_SMTP_PORT="587"       # only for mode=direct
# ALERT_EMAIL_USERNAME=""           # only for mode=direct
# ALERT_EMAIL_PASSWORD=""           # only for mode=direct
# ALERT_EMAIL_TEMPLATE=""           # custom HTML template path (optional)
# ALERT_EMAIL_CATEGORIES="forbidden_domain,unknown_device,admin_lockout,critical_service"  # high-value surveillance alerts (dns_flood suppressed by default)

# VPN remote access (Tailscale)
# When enabled, the dashboard is accessible remotely via Tailscale mesh VPN.
# Run 'sudo oshotspot setup-vpn' to install and configure.
# VPN_ENABLED="false"
# VPN_URL=""
